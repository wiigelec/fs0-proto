      "record_type": "requirement",
      "requirement_id": "FS0-GOV-001",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "FS0 Governance SHALL implement Design Proposal -> Design -> Plan -> Build -> accepted repository state.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-002",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "Design SHALL use Audit, Normalize, Accept; Plan SHALL use Analyze, Specify, Accept; Build SHALL use Implement, Verify, Accept.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-003",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "Each governed Design, Plan, and Build work item SHALL record stable identity, predecessor, scope, material exclusions where applicable, candidate result, completion conditions, disposition, provenance, and bounded authorization.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-004",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "Design SHALL consume a non-authoritative Design Proposal.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-005",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "Plan SHALL consume accepted Design authority and define realization intent covering affected artifacts, Conformance work, Assurance work, dependencies, sequencing, and bounded Build scope.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-006",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "Build SHALL consume an accepted Plan and implement only work authorized by that Plan.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-007",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "Semantic defects SHALL route to Design, realization-intent defects to Plan, and implementation defects to Build.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "none",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-008",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "Governance acceptance SHALL be explicit, attributable, traceable, and candidate-specific.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-009",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "A Governance acceptance decision SHALL depend only on authority accepted before the candidate acquires authority produced by that acceptance.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "none",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-GOV-010",
      "owner_authority_id": "FS0-AUTH-GOVERNANCE",
      "statement": "A governed work item SHALL authorize only its explicit scope.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
