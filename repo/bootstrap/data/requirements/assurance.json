  "requirements": [
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-001",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "Every active accepted requirement SHALL have exactly one canonical Assurance correspondence declaring applicability required or none.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "none"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-002",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "Every requirement with Assurance applicability required SHALL resolve from accepted authorizing authority to a review obligation and review case with subject, evidence, finding, and Governance disposition.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-003",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "FS0 Assurance SHALL support requirement-quality, ambiguity, contradiction, Design-fidelity, Plan-fidelity, Build-fidelity, Conformance-interpretation, and evidence-sufficiency review.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-004",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "FS0 Assurance findings SHALL support at least satisfied, defect, insufficient, and governance-required.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "none"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-005",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "Every governed Assurance case SHALL identify authorizing authority, review obligation, reviewed subject, evidence, material exclusions where applicable, and finding identity.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-006",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "A review subject SHALL NOT authorize its own Assurance review.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-007",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "Assurance findings SHALL be case-specific.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "none",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-008",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "Each installed Assurance correspondence record SHALL contain requirement_id, applicability, and obligation_ids.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "none"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-009",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "In the fixed FS0 GitHub binding, each Assurance review case and finding SHALL be a structured maintained repository artifact.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-010",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "An Assurance finding SHALL NOT independently create, amend, supersede, or withdraw persistent normative authority.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "none",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-011",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "Persistent semantic change identified by Assurance SHALL route through Governance Design.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "none",
      "assurance_applicability": "required"
    },
    {
      "schema_version": "1",
      "record_type": "requirement",
      "requirement_id": "FS0-ASSUR-012",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "An Assurance correspondence with applicability required SHALL contain at least one stable review-obligation identity.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "none"
    },
