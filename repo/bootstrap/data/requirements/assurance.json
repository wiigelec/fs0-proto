      "requirement_id": "FS0-ASSUR-015",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "Assurance requirement-quality review SHALL detect materially compound identified requirements and material semantic omission caused by statement-length compression.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "none",
      "assurance_applicability": "required"
