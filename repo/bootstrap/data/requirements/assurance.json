      "requirement_id": "FS0-ASSUR-014",
      "owner_authority_id": "FS0-AUTH-ASSURANCE",
      "statement": "Assurance review cases and findings SHALL be remotely accessible in the fixed FS0 GitHub binding.",
      "lifecycle_state": "accepted",
      "conformance_applicability": "mechanical",
      "assurance_applicability": "required"
    },
    {
