{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-spec:schema:plan-file:1",
  "title": "repo-spec Plan File Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "plan_id",
    "file_change"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "artifact_type": {
      "const": "plan-file"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "file_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operation",
        "purpose",
        "requirement_ids",
        "implementation",
        "validation_ids"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "operation": {
          "enum": [
            "create",
            "modify",
            "delete",
            "regenerate"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]*-NR-[0-9]{3}$"
          }
        },
        "implementation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated_consequences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "description"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "validation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^VAL-[0-9]{3}$"
          }
        }
      }
    }
  }
}
