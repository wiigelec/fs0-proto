{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-spec:schema:plan:2",
  "title": "repo-spec Plan Manifest",
  "description": "Defines the canonical root manifest for one logical repo-spec Plan. The Plan is a closed graph of explicitly referenced durable subdocuments. Unreferenced files do not become Plan authority merely by existing in the functional-set directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "plan",
    "functional_set",
    "implementation_predecessor",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "artifact_type": {
      "const": "plan"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "functional_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^repo/bootstrap/data/plan/[0-9]{3}_[A-Za-z0-9._-]+/functional-set\\.json$"
        }
      }
    },
    "implementation_predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_revision"
      ],
      "properties": {
        "repository_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "file_plans",
        "execution",
        "invariants",
        "validation",
        "completion"
      ],
      "properties": {
        "requirements": {
          "const": "requirements.json"
        },
        "file_plans": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^files/[0-9]{3}-[A-Za-z0-9._-]+\\.json$"
          }
        },
        "execution": {
          "const": "execution.json"
        },
        "invariants": {
          "const": "invariants.json"
        },
        "validation": {
          "const": "validation.json"
        },
        "completion": {
          "const": "completion.json"
        }
      }
    }
  }
}
