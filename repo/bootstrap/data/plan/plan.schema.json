{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-spec:schema:plan:1",
  "title": "repo-spec Plan",
  "description": "Defines the durable Planning output for one functional set. A Plan binds one functional-set artifact and exact accepted predecessor, records Planning-distilled normative requirements, defines exact file mutation scope and implementation intent, orders executable work, specifies invariants and validation, declares generated consequences, and states completion and acceptance conditions. The Plan is the implementation contract consumed by Build.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "plan",
    "functional_set",
    "accepted_predecessor",
    "normative_requirements",
    "file_changes",
    "execution",
    "invariants",
    "validation",
    "completion_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "artifact_type": {
      "const": "plan"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Stable Plan identity."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable statement of the implementation contract."
        }
      }
    },
    "functional_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^repo/bootstrap/data/plan/[0-9]{3}_[A-Za-z0-9._-]+/functional-set\\.json$",
          "description": "Canonical functional-set artifact realized by this Plan."
        }
      }
    },
    "accepted_predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_revision"
      ],
      "properties": {
        "repository_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "normative_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "evaluation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]*-NR-[0-9]{3}$",
            "description": "Planning-assigned normative requirement identity."
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "One independently governed normative obligation."
          },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conformance",
              "assurance"
            ],
            "properties": {
              "conformance": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "applicability"
                ],
                "properties": {
                  "applicability": {
                    "enum": [
                      "required",
                      "none"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "applicability": {
                          "const": "none"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "rationale"
                      ]
                    }
                  }
                ]
              },
              "assurance": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "applicability"
                ],
                "properties": {
                  "applicability": {
                    "enum": [
                      "required",
                      "none"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "applicability": {
                          "const": "none"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "rationale"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "file_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operation",
          "purpose",
          "requirement_ids",
          "implementation",
          "validation_ids"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "operation": {
            "enum": [
              "create",
              "modify",
              "delete",
              "regenerate"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9._-]*-NR-[0-9]{3}$"
            }
          },
          "implementation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Ordered pseudo-code or equivalent implementation specification for this path."
          },
          "depends_on_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "generated_consequences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "description"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "validation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VAL-[0-9]{3}$"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_steps"
      ],
      "properties": {
        "ordered_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "description",
              "paths"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9._-]*-NR-[0-9]{3}$"
            }
          }
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "success_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VAL-[0-9]{3}$"
          },
          "kind": {
            "enum": [
              "schema",
              "reference",
              "syntax",
              "parse",
              "compile",
              "unit",
              "integration",
              "conformance",
              "assurance",
              "repository",
              "operational",
              "custom"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "success_criteria": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9._-]*-NR-[0-9]{3}$"
            }
          }
        }
      }
    },
    "completion_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^COMP-[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "validation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VAL-[0-9]{3}$"
            }
          }
        }
      }
    }
  }
}
