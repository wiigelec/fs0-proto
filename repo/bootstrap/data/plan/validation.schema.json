{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-spec:schema:plan-validation:1",
  "title": "repo-spec Plan Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "plan_id",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "artifact_type": {
      "const": "plan-validation"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "success_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VAL-[0-9]{3}$"
          },
          "kind": {
            "enum": [
              "schema",
              "reference",
              "syntax",
              "parse",
              "compile",
              "unit",
              "integration",
              "conformance",
              "assurance",
              "repository",
              "operational",
              "custom"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "success_criteria": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9._-]*-NR-[0-9]{3}$"
            }
          }
        }
      }
    }
  }
}
